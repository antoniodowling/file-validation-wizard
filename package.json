{
  "name": "hnb-payment-file-validator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:readme": "vite build --config vite.readme.config.ts && node scripts/finalize-readme-package.mjs",
    "test": "vitest run",
    "test:stress-files": "node --test tests/stress-files.test.mjs",
    "generate:stress-files": "node scripts/generate-stress-files.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run test && npm run test:stress-files && npm run build && npm run build:readme && npm run test:e2e"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "fast-xml-parser": "^5.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
